package com.demo

enum class Unit {
    METRE,
    FOOT
}
//- /com/demo/Main.kt
package com.demo

class Main {
    fun factor(unit: Unit): Double {
        return when (unit) {
            Unit.METRE -> 1.0
            Unit.FO$0OT -> 0.3
        }
    }
}
