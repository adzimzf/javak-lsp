package com.demo

class Circle(val radius: Double) {
    var label: String = ""
    val isUnit: Boolean = false

    companion object {
        fun unit(): Circle {
            return Circle(1.0)
        }
    }
}

fun describe(circle: Circle): String {
    return circle.label
}
