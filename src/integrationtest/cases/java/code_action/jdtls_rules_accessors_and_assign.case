package p;

public abstract class Node {
    Node parentNode;
    int siblingIndex;
    boolean isBlank;

    public Node parentNode() { return parentNode; }
    protected void setParentNode(Node parentNode) { this.parentNode = parentNode; }
    protected void setSiblingIndex(int siblingIndex) { this.siblingIndex = siblingIndex; }
    public boolean isBlank() { return isBlank; }
    public void setBlank(boolean isBlank) { this.isBlank = isBlank; }

    void indent(Node accum) {
        accum.$0parentNode();
    }
}
