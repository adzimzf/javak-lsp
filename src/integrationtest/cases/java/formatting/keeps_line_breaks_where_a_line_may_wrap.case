package com.demo;

public class Wraps {
	void wraps() {
		String s = "a" +
				"b";
		int r = compute(1,
				2,
				3);
		boolean b = r > 1
				&& r < 3;
		StringBuilder sb = new StringBuilder()
				.append("x")
