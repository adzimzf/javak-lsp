package com.demo;

import java.util.List;
import lombok.Builder;
import lombok.Singular;

@Builder(toBuilder = true)
public class Order {
    private String customer;
    private int quantity;
    @Builder.Default
    private boolean express = false;
    @Singular
    private List<String> items;
}
