      foo();
      bar();
    }

  }

  public static class Child extends Base {

    Child() {
      super();
      foo();
      bar();
      method_1();
      protectedField = 300;
      protectedField = 400;
    }

    protected void method_2() {
      method_1();
      method_1();
      method_1();
    }

  }

  public void recursive1() {
    recursive2();
  }

  public void recursive2() {
    recursive1();
  }
}
