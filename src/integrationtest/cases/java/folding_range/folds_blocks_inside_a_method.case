package com.demo;

class Flow$0 {
    void run(int k, java.util.List<String> names) {
        if (k > 0) { k--; }
        if (k > 1) {
            k++;
        } else if (k < 0) {
            k--;
        } else {
            k = 0;
        }
        names.forEach(name -> {
            System.out.println(name);
        });
        new Thread(new Runnable() {
            public void run() {}
        }).start();
        switch (k) {
            case 1:
            case 2:
            {
                k++;
            }
            case 3:
                break;
            default:
        }
    }
}
