@Slf4j
@RequiredArgsConstructor
public class Service {
    private final Repo repo;
    @NonNull
    private String label;
    private int count;

    void run(Person person) {
        log.info(person.getName());
        person.setActive(person.isActive());
        new Service(repo, "x");
    }
}
